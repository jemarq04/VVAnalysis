{
  "electrons": {
    "name": "ElectronSF_HZZ",
    "desc": "HZZ electron ID SFs for Run 3 samples. Converted using electron SFs from https://github.com/CJLST/ZZAnalysis/tree/Run3/AnalysisStep/data/LeptonEffScaleFactors",
    "sfname": "EGamma_SF2D",
    "uncname": "EGamma_Unc2D",
    "inputs": {
      "eta": "Electron eta",
      "pt": "Electron pT [GeV]"
    },
    "output": {
      "name": "weight",
      "desc": "HZZ ID scale factor"
    },
    "corrections": {
      "2022BCD": {
        "file": "inputs/2022/SF2022eleID_preEE.root",
        "desc": "2022BCD (preEE) HZZ electron ID SFs"
      },
      "2022EFG": {
        "file": "inputs/2022/SF2022eleID_postEE.root",
        "desc": "2022EFG (postEE) HZZ electron ID SFs"
      },
      "2023C": {
        "file": "inputs/2023/SF2023eleID_preBPix.root",
        "desc": "2023C (preBPix) HZZ electron ID SFs"
      },
      "2023C_Gap": {
        "file": "inputs/2023/SF2023eleID_Gap_preBPix.root",
        "desc": "2023C (preBPix) HZZ electron ID SFs (1.444 < |eta| < 1.556)"
      },
      "2023D": {
        "file": "inputs/2023/SF2023eleID_postBPix.root",
        "desc": "2023D (postBPix) HZZ electron ID SFs"
      },
      "2023D_Gap": {
        "file": "inputs/2023/SF2023eleID_Gap_preBPix.root",
        "desc": "2023D (postBPix) HZZ electron ID SFs (1.444 < |eta| < 1.556)",
        "err_mult": 2
      },
      "2023D_Hole": {
        "file": "inputs/2023/SF2023eleID_postBPix_Hole.root",
        "desc": "2023D (postBPix) HZZ electron ID SFs"
      },
      "2024": {
        "file": "inputs/2024/SF2024eleID.root",
        "desc": "2024 HZZ electron ID SFs (-1.5 < eta < 0 and -1.2 < phi < -0.8)"
      },
      "2024_Gap": {
        "file": "inputs/2024/SF2024eleID_Gap.root",
        "desc": "2024 HZZ electron ID SFs (1.444 < |eta| < 1.556)"
      }
    }
  },
  "muons": {
    "name": "MuonSF_HZZ",
    "desc": "HZZ muon ID SFs for Run 3 samples. Converted using muon SFs from https://github.com/CJLST/ZZAnalysis/tree/Run3/AnalysisStep/data/LeptonEffScaleFactors",
    "sfname": "FINAL",
    "uncname": "ERROR",
    "inputs": {
      "eta": "Muon eta",
      "pt": "Muon pT [GeV]"
    },
    "output": {
      "name": "weight",
      "desc": "HZZ ID scale factor"
    },
    "corrections": {
      "2022BCD": {
        "file": "inputs/2022/final_HZZ_SF_Run3_2022_mupogsysts_newLoose_abseta3_fix_BCD_RMS.root",
        "desc": "2022BCD (preEE) HZZ muon ID SFs"
      },
      "2022EFG": {
        "file": "inputs/2022/final_HZZ_SF_Run3_2022_mupogsysts_newLoose_abseta3_fix_EFG_RMS.root",
        "desc": "2022EFG (postEE) HZZ muon ID SFs"
      },
      "2023C": {
        "file": "inputs/2023/final_HZZ_SF_2023C_RMS_mupogsysts.root",
        "desc": "2023C (preBPix) HZZ muon ID SFs"
      },
      "2023D": {
        "file": "inputs/2023/final_HZZ_SF_2023D_RMS_mupogsysts.root",
        "desc": "2023D (postBPix) HZZ muon ID SFs"
      },
      "2024": {
        "file": "inputs/2024/HZZ_HZZ_SF_2024_RMS_mupogsystsC.root",
        "desc": "2024 HZZ muon ID SFs"
      }
    }
  }
}
